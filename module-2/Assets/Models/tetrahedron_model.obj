# Simple tetrahedron mesh with UV coordinates and material
mtllib tetrahedron.mtl

# Tetrahebron

# Vertex position

v 1.0 0.0 0.0
v -1.0 0.0 -1.0
v -1.0 0.0 1.0
v 0.0 2.0 0.0

# Normals

vn 0.0 -1.0 0.0
vn 0.436 0.218 0.072
vn -0.094 0.447 0.0
vn 0.436 0.218 -0.072

usemtl TetrahedronMaterial
# Texture coordinates
vt 0.0 0.0
vt 1.0 0.0
vt 1.0 1.0
vt 0.0 1.0
vt 0.5 0.5

# Faces
# Vertex / texture coordinate / normal

f 1/1/1 3/2/1 2/3/1
f 1/2/4 2/3/4 4/5/4
f 2//3 3//3 4//3
f 4//2 3//2 1//2
